generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { resident admin webmaster }
enum RequestStatus { pending under_review approved rejected ready_for_pickup completed }
enum ConcernStatus { open in_progress resolved closed }
enum AccountStatus { pending active suspended rejected }
enum ApplicationStatus { pending approved rejected }
enum AuditActorType { resident admin webmaster system }
enum CredentialAction { suspended reactivated }

model User {
  id String @id @default(uuid())
  fullName String
  email String @unique
  passwordHash String
  role Role @default(resident)
  address String?
  contactNumber String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staffId String? @unique
  accountStatus AccountStatus @default(active)
  requests DocumentRequest[] @relation("Requestor")
  notices Notice[] @relation("PostedBy")
  concerns Concern[] @relation("Reporter")
  requestHistoryEvents RequestStatusHistory[] @relation("RequestHistoryActor")
  concernHistoryEvents ConcernStatusHistory[] @relation("ConcernHistoryActor")
  reviewedApplications AdminApplication[] @relation("ApplicationReviewer")
  credentialEventsFor AdminCredentialEvent[] @relation("CredentialEventSubject")
  credentialEventsBy AdminCredentialEvent[] @relation("CredentialEventActor")
  auditEvents AuditEvent[] @relation("AuditEventActor")
}

model DocumentRequest {
  id String @id @default(uuid())
  requestorId String
  requestor User @relation("Requestor", fields: [requestorId], references: [id])
  documentType String
  purpose String
  status RequestStatus @default(pending)
  attachments Json @default("[]")
  statusHistory Json @default("[]")
  trackingNumber String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  history RequestStatusHistory[]
}

model Official {
  id String @id @default(uuid())
  name String
  position String
  committee String?
  photoUrl String?
  termStart DateTime?
  termEnd DateTime?
  contactInfo String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notice {
  id String @id @default(uuid())
  title String
  body String
  category String?
  postedById String
  postedBy User @relation("PostedBy", fields: [postedById], references: [id])
  publishedAt DateTime @default(now())
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Concern {
  id String @id @default(uuid())
  reporterId String?
  reporter User? @relation("Reporter", fields: [reporterId], references: [id])
  category String
  description String
  location String?
  status ConcernStatus @default(open)
  attachments Json @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  history ConcernStatusHistory[]
}

model RequestStatusHistory {
  id String @id @default(uuid())
  requestId String
  request DocumentRequest @relation(fields: [requestId], references: [id])
  fromStatus RequestStatus?
  toStatus RequestStatus
  actorUserId String?
  actor User? @relation("RequestHistoryActor", fields: [actorUserId], references: [id])
  actorType AuditActorType
  actorStaffId String?
  note String?
  createdAt DateTime @default(now())
  @@index([requestId])
}

model ConcernStatusHistory {
  id String @id @default(uuid())
  concernId String
  concern Concern @relation(fields: [concernId], references: [id])
  fromStatus ConcernStatus?
  toStatus ConcernStatus
  actorUserId String?
  actor User? @relation("ConcernHistoryActor", fields: [actorUserId], references: [id])
  actorType AuditActorType
  actorStaffId String?
  note String?
  createdAt DateTime @default(now())
  @@index([concernId])
}

model AdminApplication {
  id String @id @default(uuid())
  applicantName String
  email String
  passwordHash String
  status ApplicationStatus @default(pending)
  reviewedById String?
  reviewedBy User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  reviewNote String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
}

model AdminCredentialEvent {
  id String @id @default(uuid())
  userId String
  user User @relation("CredentialEventSubject", fields: [userId], references: [id])
  action CredentialAction
  performedById String
  performedBy User @relation("CredentialEventActor", fields: [performedById], references: [id])
  note String?
  createdAt DateTime @default(now())
  @@index([userId])
}

// Shared append-only operational ledger for all meaningful Admin mutations.
// before/after are snapshots; actorName/staffId are snapshots too, preserving
// historical attribution even if a staff profile changes later.
model AuditEvent {
  id String @id @default(uuid())
  actorUserId String?
  actor User? @relation("AuditEventActor", fields: [actorUserId], references: [id])
  actorName String
  actorStaffId String?
  actorType AuditActorType
  module String
  action String
  recordId String
  recordLabel String?
  before Json?
  after Json?
  note String?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([module, recordId])
  @@index([actorUserId, createdAt])
}

model TrackingCounter { year Int @id count Int @default(0) }
model StaffIdCounter { prefix String @id count Int @default(0) }
